<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}TickUp - Home{% endblock %}</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>

    <body class="bg-light d-flex flex-column min-vh-100">

      <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container px-4 px-lg-5">

            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-3 text-primary" href="{{ path('app_home') }}">
                Tick'Up
            </a>

            <!-- Toggle pour mobile -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Liens -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="{{ path('app_movies') }}">Films</a>
                    </li>
                    <li class="nav-item ms-3 me-3">
                        <a class="nav-link fw-semibold" href="{{ path('app_booking') }}">Réservation</a>
                    </li>

                    {# ---- AUTHENTIFICATION ---- #}
                    {% if app.user %}
                        <li class="nav-item ms-4">
                            <span class="navbar-text fw-medium text-dark me-2">
                                {{ app.user.firstName ?? app.user.userIdentifier }}
                            </span>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-outline-danger btn-sm fw-bold"
                            href="{{ path('app_logout') }}">
                                Se déconnecter
                            </a>
                        </li>
                    {% else %}
                        <li class="nav-item ms-4">
                            <a class="btn btn-outline-primary btn-sm fw-bold me-2"
                            href="{{ path('app_login') }}">
                                Se connecter
                            </a>
                            <a class="btn btn-primary btn-sm fw-bold"
                            href="{{ path('app_register') }}">
                                S'inscrire
                            </a>
                        </li>
                    {% endif %}

                </ul>
            </div>
        </div>
    </nav>


        <!-- CONTENU -->
        <main class="container px-4 px-lg-5 my-5 flex-grow-1">
            {% block body %}

                <!-- BANNIÈRE -->
                <section class="mb-3">
                        <div class="p-2 rounded text-center">
                            <h1 class="display-6 fw-bold">Bienvenue sur TickUp</h1>
                            <p class="lead mb-0">
                                Réservez vos séances de cinéma en toute simplicité !
                            </p>
                        </div>
                    </div>
                </section>

                <!-- FILM DU MOMENT -->
                <section>
                    <h2 class="mb-4">Film du moment</h2>

                    {% if movie %}
                        <div class="row align-items-center bg-white rounded shadow-sm p-4">

                            <!-- Poster -->
                            <div class="col-md-5 mb-3 mb-md-0">
                                <img 
                                    src="{{ movie.poster }}"
                                    class="img-fluid rounded"
                                    alt="{{ movie.title }}"
                                >
                            </div>

                            <!-- Infos -->
                            <div class="col-md-7">
                                <h3 class="fw-bold mb-5">{{ movie.title }}</h3>

                                <p class="text-muted">
                                    Sortie le {{ movie.releaseDate|date('d/m/Y') }}
                                </p>

                                <p class="lead mb-5">
                                    {{ movie.synopsis }}
                                </p>

                                <a 
                                    href="{{ path('app_show', { id: movie.id }) }}"
                                    class="btn btn-primary btn-lg"
                                >
                                    Plus d'info
                                </a>
                            </div>

                        </div>
                    {% else %}
                        <div class="alert alert-warning">
                            Aucun film disponible pour le moment.
                        </div>
                    {% endif %}
                </section>

            {% endblock %}

        </main>

        <!-- FOOTER -->
        <footer class="bg-white text-center text-muted py-3 border-top">
            <small>
                © {{ "now"|date("Y") }} TickUp — Projet PHP
            </small>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
