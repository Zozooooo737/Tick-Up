{% extends 'base.html.twig' %}
{% block title %}Tick'Up - Réservation{% endblock %}

{% block body %}
<div class="bg-light min-vh-100 d-flex justify-content-center align-items-start py-5">
    <div class="card shadow-lg text-dark p-4" style="width: 500px;">
        <h1 class="card-title mb-4 text-center">Réserver une séance</h1>

        {# --- Sélection du film --- #}
        <form method="get" action="{{ path('app_booking') }}">
            <div class="mb-3">
                <label class="form-label">Film</label>
                <select name="movie" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Choisir un film --</option>
                    {% for m in movies %}
                        <option value="{{ m.id }}" {% if movie and m.id == movie.id %}selected{% endif %}>
                            {{ m.title }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </form>

        {% if movie %}
        <form method="post" class="mt-4" action="{{ path('app_booking_recap') }}">

            <div class="mb-3">
                <label class="form-label">Séance</label>
                <select name="screening" class="form-select" id="screening-select" required>
                    {% for screening in screenings %}
                        {% if screening.remainingPlaces > 0 %}
                            <option 
                                value="{{ screening.id }}"
                                data-remaining="{{ screening.remainingPlaces }}"
                            >
                                {{ screening.dateTime|date('d/m/Y H:i') }}
                                — Salle {{ screening.room.name }}
                                ({{ screening.remainingPlaces }} places restantes)
                            </option>
                        {% endif %}
                    {% endfor %}
                </select>

                <p class="text-muted mt-2" id="remaining-text"></p>
            </div>

            <div class="mb-3">
                <label class="form-label">Nombre de places</label>
                <input 
                    type="number"
                    name="places"
                    class="form-control"
                    min="1"
                    required
                >
            </div>

            <button class="btn btn-primary w-100">Continuer</button>

        </form>
        {% endif %}
    </div>
</div>
{% endblock %}
