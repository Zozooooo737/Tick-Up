{% extends 'base.html.twig' %}

{% block title %}Récapitulatif{% endblock %}

{% block body %}
<div class="bg-light min-vh-100 d-flex justify-content-center align-items-start py-5">
    <div class="card shadow-lg text-dark" style="width: 400px;">
        <div class="card-body">
            <h1 class="card-title text-center mb-4">Récapitulatif</h1>

            <p><strong>Utilisateur :</strong> {{ userEmail }}</p>
            <p><strong>Film :</strong> {{ screening.movie.title }}</p>
            <p><strong>Date :</strong> {{ screening.dateTime|date('d/m/Y H:i') }}</p>
            <p><strong>Salle :</strong> {{ screening.room.name }}</p>
            <p><strong>Places :</strong> {{ places }}</p>
            <p><strong>Prix :</strong> {{ pricePerPerson }} €</p>
            <p><strong>Total :</strong> {{ totalPrice }} €</p>

            <form method="post" action="{{ path('app_booking_confirm') }}" class="mt-4">
                <input type="hidden" name="screening" value="{{ screening.id }}">
                <input type="hidden" name="places" value="{{ places }}">
                <button class="btn btn-success w-100">Confirmer et payer</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
