{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }} | TickUp{% endblock %}

{% block body %}

<div class="row g-5 px-4 px-lg-5">

    <!-- Poster -->
    <div class="col-md-4">
        <img 
            src="{{ movie.poster }}"
            class="img-fluid rounded shadow"
            alt="{{ movie.title }}"
        >
    </div>

    <!-- Infos film -->
    <div class="col-md-8">

        <h1 class="fw-bold mb-3">{{ movie.title }}</h1>

        <p class="text-muted">
            {{ movie.genre }} • {{ movie.duration }} min
            {% if movie.releaseDate %}
                • Sortie le {{ movie.releaseDate|date('d/m/Y') }}
            {% endif %}
        </p>

        <p class="lead">
            {{ movie.synopsis }}
        </p>

        <ul class="list-unstyled">
            {% if movie.director %}
                <li><strong>Réalisateur :</strong> {{ movie.director }}</li>
            {% endif %}
            {% if movie.actors %}
                <li><strong>Acteurs :</strong> {{ movie.actors }}</li>
            {% endif %}
        </ul>

        <!-- Boutons -->
        <div class="mt-4 d-flex gap-3 flex-wrap">

            {% if movie.trailer %}
                <button 
                    class="btn btn-outline-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#trailerModal"
                >
                    Bande-annonce
                </button>
            {% endif %}

            <a href="{{ path('app_booking', { movie: movie.id }) }}" class="btn btn-primary">
                Voir ce film
            </a>

        </div>

    </div>
</div>

{% if screenings is not empty %}
    <h3 class="mt-5 mb-3">Séances disponibles</h3>

    <ul class="list-group">
        {% for screening in screenings %}
            {% if screening.getRemainingPlaces() > 0 %}
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">

                    <!-- Infos séance -->
                    <div>
                        <span class="fw-semibold">
                            {{ screening.dateTime|date('d/m/Y') }}
                        </span>
                        <span class="text-muted ms-2">
                            {{ screening.dateTime|date('H:i') }}
                        </span>
                        <span class="text-muted ms-2 me-4">
                            — Salle {{ screening.room.name }}
                        </span>

                        <span class="ms-3 fw-semibold text-primary">
                            {{ screening.price }} € / place
                        </span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex align-items-center mt-2 mt-sm-0">
                        <span class="badge bg-secondary rounded-pill me-3">
                            {{ screening.getRemainingPlaces() }} places restantes
                        </span>

                        <a
                            href="{{ path('app_booking', { movie: movie.id, screening: screening.id }) }}"
                            class="btn btn-sm btn-primary"
                        >
                            Réserver
                        </a>
                    </div>

                </li>
            {% endif %}
        {% else %}
            <li class="list-group-item text-muted">
                Aucune séance disponible pour le moment.
            </li>
        {% endfor %}
    </ul>
{% endif %}



<!-- TRAILER -->
{% if movie.trailer %}
<div class="modal fade" id="trailerModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-0">
                <iframe
                    width="100%"
                    height="400"
                    src="{{ movie.trailer }}"
                    frameborder="0"
                    allowfullscreen
                ></iframe>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}
